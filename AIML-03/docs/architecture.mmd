flowchart LR
  subgraph OFFLINE["Offline pipeline (Airflow DAG, weekly)"]
    direction TB
    R[("MovieLens 25M<br/>25.0M ratings")] --> S["Spark<br/>time-safe tables:<br/>interactions, user/item stats,<br/>user history, rated items"]
    S --> TT["Two-tower training<br/>(TensorFlow Recommenders)"]
    S --> KNN["Item-KNN<br/>neighbour matrix"]
    TT --> EV["Evaluate retriever<br/>on validation users"]
    EV --> GATE{"Quality gate:<br/>Recall@100 vs production"}
    GATE -- fail --> X["Stop, keep production"]
    GATE -- pass --> B["Build bundle:<br/>train DCN-v2 and Wide and Deep<br/>on two-source candidates,<br/>export SavedModels"]
    KNN --> B
    S --> B
    B --> P[("Versioned bundle<br/>atomic symlink promote")]
  end
  subgraph ONLINE["Online serving"]
    direction TB
    C["Client"] --> API["FastAPI<br/>/recommend, /recommend/ab"]
    API <--> RD[("Redis<br/>response cache")]
    API --> ROUTE{"Has liked<br/>items?"}
    ROUTE -- no --> POP["Cold start:<br/>popularity or<br/>genre-filtered popularity"]
    ROUTE -- yes --> RET["Candidates, 250:<br/>two-tower via FAISS HNSW<br/>(built at startup)<br/>+ item-KNN, interleaved"]
    RET --> RANK["Re-rank:<br/>DCN-v2 or Wide and Deep<br/>(A/B arms by user hash)"]
    RANK -. optional .-> TRI["Triton<br/>TF SavedModel"]
    RANK --> OUT["Top-K with titles,<br/>genres, scores"]
    POP --> OUT
  end
  P --> API
